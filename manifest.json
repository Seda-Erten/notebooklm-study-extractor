{
  "manifest_version": 3,
  "name": "NotebookLM Study Extractor",
  "version": "1.0.0",
  "description": "Export your NotebookLM study guide data (tests and flashcards) to Word and Excel in seconds.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}